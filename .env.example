# Base PostgreSQL (Neon). Chaîne « pooled » recommandée ; le code ajoute lui-même connect_timeout=20.
DATABASE_URL="postgresql://utilisateur:motdepasse@hote.eu-west-2.aws.neon.tech/neondb?sslmode=require"

# Back-office (/admin) : mot de passe unique et secret de signature de session (32 caractères aléatoires au moins).
ADMIN_PASSWORD="à-changer"
ADMIN_SECRET="à-générer-avec-openssl-rand-hex-32"

# Adresse publique du site (métadonnées, sitemap, robots).
NEXT_PUBLIC_SITE_URL="https://formations-ferroviaires.vercel.app"

# Formulaire de contact : sans RESEND_API_KEY, les messages restent en base (onglet Messages du back-office) sans courriel.
RESEND_API_KEY=""
CONTACT_TO="contact@objectif-ofp.org"
CONTACT_FROM="Formations ferroviaires <contact@votre-domaine.fr>"
